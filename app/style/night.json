{
  "version": 8,
  "name": "Garmaxxing Night",
  "metadata": { "garmaxxing:theme": "night" },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sprite": "/sprites/garmaxxing",
  "sources": {
    "gb": {
      "type": "vector",
      "url": "pmtiles:///maps/gb.pmtiles"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#10141c" } },
    {
      "id": "landcover",
      "type": "fill",
      "source": "gb",
      "source-layer": "landcover",
      "paint": { "fill-color": "#16201a", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "gb",
      "source-layer": "water",
      "paint": { "fill-color": "#10283f" }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "gb",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": { "line-color": "#3a4150", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 6] }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "gb",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": { "line-color": "#5a5230", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 18, 10] }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "gb",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk", "motorway"],
      "paint": { "line-color": "#8a6a2f", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 18, 14] }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "gb",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": { "text-color": "#c9cdd6", "text-halo-color": "#10141c", "text-halo-width": 1.5 }
    }
  ]
}
