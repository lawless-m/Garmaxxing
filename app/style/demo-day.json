{
  "version": 8,
  "name": "Garmaxxing Demo Day",
  "metadata": {
    "garmaxxing:theme": "day",
    "garmaxxing:note": "Dev-only raster style. Needs network. Production uses day.json over gb.pmtiles."
  },
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#e9e6df" } },
    { "id": "osm", "type": "raster", "source": "osm" }
  ]
}
